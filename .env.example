# Local/dev environment template. Copy to .env and adjust as needed.
# The service also reads these directly from the process environment in prod.

# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seats?sslmode=disable

# HTTP port the service listens on.
PORT=8080

# Upper bound on DB connections. Kept small so contention is resolved by row
# locks rather than connection exhaustion.
DB_MAX_CONNS=25

AUTH_SECRET=local-signing-secret-not-for-production-12345
ADMIN_TOKEN=local-admin-credential-not-for-production-12345
HTTP_PORT=8080
